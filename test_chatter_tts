e' key\")\n","        if audio_type not in audio_map:\n","            raise KeyError(\n","                f\"Chunk '{label}' has audio_type='{audio_type}', which is not \"\n","                f\"in audio_map. Available: {list(audio_map.keys())}\"\n","            )\n","        audio_prompt_path = audio_map[audio_type]\n"," \n","        exaggeration = chunk.get(\"exaggeration\", 0.5)\n","        temperature = chunk.get(\"temperature\", 0.8)\n","        cfg_weight = chunk.get(\"cfg_weight\", 0.5)\n"," \n","        print(f\"[chatterbox] generating [{i+1}/{len(chunks)}] '{label}' \"\n","              f\"(audio_type={audio_type}, exaggeration={exaggeration}, \"\n","              f\"temperature={temperature}, cfg_weight={cfg_weight})\")\n"," \n","        wav = model.generate(\n","            text,\n","            audio_prompt_path=audio_prompt_path,\n","            exaggeration=exaggeration,\n","            temperature=temperature,\n","            cfg_weight=cfg_weight,\n","        )\n"," \n","        if normalize_loudness:\n","            wav = _normalize(wav)\n"," \n","        segments.append(wav)\n","        if i < len(chunks) - 1:\n","            segments.append(silence)\n"," \n","    combined = torch.cat(segments, dim=-1)\n","    ta.save(output_path, combined, sr)\n","    print(f\"[chatterbox] saved combined audio -> {output_path}\")\n","    return output_path\n"," \n"," \n","def _normalize(wav: torch.Tensor, target_rms: float = 0.1) -> torch.Tensor:\n","    \"\"\"Simple RMS-based loudness normalization so chunks with different\n","    exaggeration/temperature settings don't jump in volume.\"\"\"\n","    rms = wav.pow(2).mean().sqrt()\n","    if rms > 0:\n","        wav = wav * (target_rms / rms)\n","    return wav.clamp(-1.0, 1.0)\n"," "]},{"cell_type":"code","execution_count":10,"id":"5baa541d","metadata":{"execution":{"iopub.execute_input":"2026-09-05T20:05:43.902919Z","iopub.status.busy":"2026-09-05T20:05:43.902517Z","iopub.status.idle":"2026-09-05T20:05:43.910016