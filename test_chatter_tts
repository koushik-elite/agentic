get(\"cfg_weight\", 0.5)\n","        label = chunk.get(\"label\", f\"chunk_{i}\")\n","\n","        print(f\"[chatterbox] generating [{i+1}/{len(chunks)}] '{label}' \"\n","              f\"(exaggeration={exaggeration}, temperature={temperature}, \"\n","              f\"cfg_weight={cfg_weight})\")\n","\n","        wav = model.generate(\n","            text,\n","            audio_prompt_path=audio_prompt_path,\n","            exaggeration=exaggeration,\n","            temperature=temperature,\n","            cfg_weight=cfg_weight,\n","        )\n","\n","        if normalize_loudness:\n","            wav = _normalize(wav)\n","\n","        segments.append(wav)\n","        if i < len(chunks) - 1:\n","            segments.append(silence)\n","\n","    combined = torch.cat(segments, dim=-1)\n","    ta.save(output_path, combined, sr)\n","    print(f\"[chatterbox] saved combined audio -> {output_path}\")\n","    return output_path\n","\n","\n","def _normalize(wav: torch.Tensor, target_rms: float = 0.1) -> torch.Tensor:\n","    \"\"\"Simple RMS-based loudness normalization so chunks with different\n","    exaggeration/temperature settings don't jump in volume.\"\"\"\n","    rms = wav.pow(2).mean().sqrt()\n","    if rms > 0:\n","        wav = wav * (target_rms / rms)\n","    return wav.clamp(-1.0, 1.0)\n","\n","model = load_model()"]},{"cell_type":"code","execution_count":9,"id":"295cc291","metadata":{"execution":{"iopub.execute_input":"2026-08-31T07:16:01.652917Z","iopub.status.busy":"2026-08-31T07:16:01.652081Z","iopub.status.idle":"2026-08-31T07:16:01.660397Z","shell.execute_reply":"2026-08-31T07:16:01.659522Z"},"papermill":{"duration":0.046856,"end_time":"2026-08-31T07:16:01.661924+00:00","exception":false,"start_time":"2026-08-31T07:16:01.615068+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["chunks = [\n","        {\n","            \"label\": \"regal_greeting\",\n","            \"text\": \"Hail, noble Cousin. I am Athena, goddess of wisdom and war.\",\n"," 